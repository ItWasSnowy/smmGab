@model IEnumerable<SmmGab.Domain.Models.Channel>
@{
    ViewData["Title"] = "Каналы";
    var projects = ViewBag.Projects as List<SmmGab.Domain.Models.Project> ?? new List<SmmGab.Domain.Models.Project>();
}

<div class="pf-page-header pf-animate">
    <div>
        <h1 class="pf-page-title">Каналы</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus me-1"></i>Создать канал
    </a>
</div>

@if (projects.Any())
{
    <div class="mb-4 pf-animate">
        <select id="projectFilter" class="form-select" style="max-width:280px;">
            <option value="">Все проекты</option>
            @foreach (var project in projects)
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
    </div>
}

@if (Model.Any())
{
    <div class="row g-3 pf-animate pf-animate-delay-1">
        @foreach (var channel in Model)
        {
            var isVk = channel.Type == SmmGab.Domain.Enums.ChannelType.Vk;
            <div class="col-md-6 col-lg-4">
                <div class="pf-item-card d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="pf-icon-badge"
                             style="background:@(isVk ? "rgba(0,119,255,0.14)" : "rgba(0,136,204,0.14)");color:@(isVk ? "#0077ff" : "#0088cc");">
                            <i class="bi @(isVk ? "bi-chat-dots-fill" : "bi-telegram")"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div style="font-weight:700;font-size:0.875rem;">@channel.DisplayName</div>
                            <span class="badge @(isVk ? "status-scheduled" : "status-publishing")" style="font-size:0.68rem;">@channel.Type</span>
                        </div>
                    </div>
                    <div style="border-top:1px solid var(--glass-border);padding-top:10px;font-size:0.78rem;color:var(--muted);">
                        <div class="mb-1"><i class="bi bi-folder me-1"></i>@channel.Project.Name</div>
                        <div><i class="bi bi-hash me-1"></i><code style="font-size:0.72rem;color:var(--muted);">@channel.ExternalId</code></div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@channel.Id" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-eye me-1"></i>Детали
                        </a>
                        <a asp-action="Edit" asp-route-id="@channel.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@channel.Id" method="post"
                              onsubmit="return confirm('Удалить канал?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card pf-animate">
        <div class="card-body text-center py-5">
            <i class="bi bi-broadcast" style="font-size:3rem;color:var(--muted);opacity:0.35;"></i>
            <p class="text-muted mt-3 mb-3" style="font-size:0.875rem;">У вас пока нет каналов</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus me-1"></i>Создайте первый канал
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('projectFilter')?.addEventListener('change', function () {
            var pid = this.value;
            window.location.href = pid
                ? '@Url.Action("Index")?projectId=' + pid
                : '@Url.Action("Index")';
        });
    </script>
}

