@{
    ViewData["Title"] = "Главная";
}

<div class="text-center mb-5 pf-animate">
    <h1 class="pf-page-title" style="font-size:2.2rem;">Добро пожаловать в <span style="color:var(--accent)">Planify</span></h1>
    <p style="color:var(--muted);font-size:0.95rem;margin-top:8px;">Система планирования публикаций в социальных сетях</p>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4 pf-animate pf-animate-delay-1">
        <a asp-controller="Projects" asp-action="Index" class="pf-home-card">
            <div class="pf-home-card-icon" style="background:rgba(255,77,109,0.14);color:var(--accent);">
                <i class="bi bi-folder2"></i>
            </div>
            <h5 style="font-family:'Playfair Display',serif;font-weight:700;margin:0 0 6px;">Проекты</h5>
            <p style="font-size:0.82rem;color:var(--muted);margin:0 0 16px;">Управляйте своими проектами и каналами</p>
            <span class="btn btn-primary btn-sm w-100"><i class="bi bi-arrow-right me-1"></i>Перейти</span>
        </a>
    </div>
    <div class="col-md-4 pf-animate pf-animate-delay-2">
        <a asp-controller="Publications" asp-action="Index" class="pf-home-card">
            <div class="pf-home-card-icon" style="background:rgba(39,201,63,0.14);color:#27C93F;">
                <i class="bi bi-file-post"></i>
            </div>
            <h5 style="font-family:'Playfair Display',serif;font-weight:700;margin:0 0 6px;">Публикации</h5>
            <p style="font-size:0.82rem;color:var(--muted);margin:0 0 16px;">Создавайте и планируйте публикации</p>
            <span class="btn btn-success btn-sm w-100"><i class="bi bi-arrow-right me-1"></i>Перейти</span>
        </a>
    </div>
    <div class="col-md-4 pf-animate pf-animate-delay-3">
        <a asp-controller="Publications" asp-action="Calendar" class="pf-home-card">
            <div class="pf-home-card-icon" style="background:rgba(59,130,246,0.14);color:#3b82f6;">
                <i class="bi bi-calendar3"></i>
            </div>
            <h5 style="font-family:'Playfair Display',serif;font-weight:700;margin:0 0 6px;">Календарь</h5>
            <p style="font-size:0.82rem;color:var(--muted);margin:0 0 16px;">Просматривайте запланированные публикации</p>
            <span class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-arrow-right me-1"></i>Открыть</span>
        </a>
    </div>
</div>

