@model List<SmmGab.Domain.Models.Project>
@{
    ViewData["Title"] = "Выбор проекта";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <div style="width:100%;max-width:620px;position:relative;z-index:1;">
        <div class="mb-4 text-end">
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Выйти
                    </button>
                </form>
            </div>
            <div class="text-center mb-4">
                <a asp-controller="Home" asp-action="Index" class="auth-logo">Plani<span>fy</span></a>
                <h2 class="auth-title mt-3">Выберите проект</h2>
                <p class="auth-sub">Выберите проект для работы или создайте новый</p>
            </div>

            @if (Model.Any())
            {
                <div class="row g-3 mb-4">
                    @foreach (var project in Model)
                    {
                        <div class="col-md-6">
                            <div class="pf-item-card" style="padding:18px;">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="pf-icon-badge" style="background:rgba(255,77,109,0.14);color:var(--accent);">
                                        <i class="bi bi-folder2"></i>
                                    </div>
                                    <div>
                                        <div style="font-weight:700;font-size:0.95rem;">@project.Name</div>
                                        <div style="font-size:0.72rem;color:var(--muted);">
                                            <i class="bi bi-calendar3 me-1"></i>@project.CreatedAtUtc.ToString("dd.MM.yyyy")
                                        </div>
                                    </div>
                                </div>
                                <form asp-action="SelectProject" method="post">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <button type="submit" class="btn btn-primary w-100 btn-sm">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Открыть
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-folder-x" style="font-size:2.5rem;color:var(--muted);opacity:0.4;"></i>
                    <p class="text-muted mt-3 mb-0" style="font-size:0.875rem;">У вас пока нет проектов</p>
                </div>
            }

            <div class="text-center mt-3">
                <a asp-controller="Projects" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus me-2"></i>Создать новый проект
                </a>
            </div>
        </div>
    </div>
</div>


