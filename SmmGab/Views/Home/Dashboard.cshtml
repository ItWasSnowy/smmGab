@model SmmGab.Domain.Models.Project
@{
    ViewData["Title"] = Model.Name;
    ViewData["ProjectName"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->
<div class="pf-page-header pf-animate">
    <div>
        <h1 class="pf-page-title">@Model.Name</h1>
        <p class="pf-page-subtitle">
            <i class="bi bi-calendar3 me-1"></i>Создан @Model.CreatedAtUtc.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))
        </p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="ChangeProject" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Сменить проект
            </button>
        </form>
        <a asp-controller="Publications" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i>Новая публикация
        </a>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 pf-animate pf-animate-delay-1">
        <div class="pf-stat-card">
            <div class="pf-stat-icon accent"><i class="bi bi-broadcast"></i></div>
            <div>
                <div class="pf-stat-num">@Model.Channels.Count</div>
                <div class="pf-stat-label">Каналов</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 pf-animate pf-animate-delay-2">
        <div class="pf-stat-card">
            <div class="pf-stat-icon blue"><i class="bi bi-file-post"></i></div>
            <div>
                <div class="pf-stat-num">@Model.Publications.Count</div>
                <div class="pf-stat-label">Публикаций</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 pf-animate pf-animate-delay-3">
        <div class="pf-stat-card">
            <div class="pf-stat-icon green"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="pf-stat-num">@Model.Publications.Count(p => p.Status == SmmGab.Domain.Enums.PublicationStatus.Published)</div>
                <div class="pf-stat-label">Опубликовано</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 pf-animate pf-animate-delay-4">
        <div class="pf-stat-card">
            <div class="pf-stat-icon gold"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="pf-stat-num">@Model.Publications.Count(p => p.Status == SmmGab.Domain.Enums.PublicationStatus.Scheduled)</div>
                <div class="pf-stat-label">Запланировано</div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-md-4 pf-animate pf-animate-delay-1">
        <a asp-controller="Channels" asp-action="Create" asp-route-projectId="@Model.Id" class="pf-action-card">
            <div class="pf-action-icon" style="background:rgba(255,77,109,0.14);color:var(--accent);">
                <i class="bi bi-plus-circle"></i>
            </div>
            <div>
                <div class="pf-action-title">Добавить канал</div>
                <div class="pf-action-desc">Подключите новый канал</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 pf-animate pf-animate-delay-2">
        <a asp-controller="Publications" asp-action="Create" asp-route-projectId="@Model.Id" class="pf-action-card">
            <div class="pf-action-icon" style="background:rgba(39,201,63,0.14);color:#27C93F;">
                <i class="bi bi-file-plus"></i>
            </div>
            <div>
                <div class="pf-action-title">Создать публикацию</div>
                <div class="pf-action-desc">Новый пост для каналов</div>
            </div>
        </a>
    </div>
    <div class="col-md-4 pf-animate pf-animate-delay-3">
        <a asp-controller="Publications" asp-action="Calendar" asp-route-projectId="@Model.Id" class="pf-action-card">
            <div class="pf-action-icon" style="background:rgba(59,130,246,0.14);color:#3b82f6;">
                <i class="bi bi-calendar3"></i>
            </div>
            <div>
                <div class="pf-action-title">Календарь</div>
                <div class="pf-action-desc">Запланированные публикации</div>
            </div>
        </a>
    </div>
</div>

<!-- Lists -->
<div class="row g-4">
    <div class="col-lg-6 pf-animate pf-animate-delay-1">
        <div class="card">
            <div class="card-header">
                <div class="pf-section-header mb-0">
                    <span class="pf-section-title"><i class="bi bi-broadcast me-2" style="color:var(--accent);"></i>Каналы</span>
                    <a asp-controller="Channels" asp-action="Index" asp-route-projectId="@Model.Id"
                       style="font-size:0.78rem;color:var(--muted);text-decoration:none;">
                        Все <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.Channels.Any())
                {
                    @foreach (var channel in Model.Channels.Take(5))
                    {
                        <div class="d-flex align-items-center gap-3 px-4 py-3" style="border-bottom:1px solid var(--glass-border);">
                            <div class="pf-icon-badge" style="background:@(channel.Type == SmmGab.Domain.Enums.ChannelType.Vk ? "rgba(0,119,255,0.15)" : "rgba(0,136,204,0.15)");color:@(channel.Type == SmmGab.Domain.Enums.ChannelType.Vk ? "#0077ff" : "#0088cc");font-size:0.85rem;">
                                @(channel.Type == SmmGab.Domain.Enums.ChannelType.Vk ? "VK" : "TG")
                            </div>
                            <div class="flex-grow-1 min-width-0">
                                <div style="font-weight:600;font-size:0.875rem;">@channel.DisplayName</div>
                                <div style="font-size:0.72rem;color:var(--muted);">@channel.ExternalId</div>
                            </div>
                            <a asp-controller="Channels" asp-action="Details" asp-route-id="@channel.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    }
                    @if (Model.Channels.Count > 5)
                    {
                        <div class="text-center py-3">
                            <a asp-controller="Channels" asp-action="Index" asp-route-projectId="@Model.Id"
                               class="btn btn-sm btn-outline-primary">Показать все (@Model.Channels.Count)</a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-broadcast" style="font-size:2.5rem;color:var(--muted);opacity:0.4;"></i>
                        <p class="text-muted mt-3 mb-2" style="font-size:0.875rem;">Нет каналов</p>
                        <a asp-controller="Channels" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">Добавить канал</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 pf-animate pf-animate-delay-2">
        <div class="card">
            <div class="card-header">
                <div class="pf-section-header mb-0">
                    <span class="pf-section-title"><i class="bi bi-file-post me-2" style="color:#27C93F;"></i>Последние публикации</span>
                    <a asp-controller="Publications" asp-action="Index" asp-route-projectId="@Model.Id"
                       style="font-size:0.78rem;color:var(--muted);text-decoration:none;">
                        Все <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentPublications != null && ((List<SmmGab.Domain.Models.Publication>)ViewBag.RecentPublications).Any())
                {
                    @foreach (var publication in (List<SmmGab.Domain.Models.Publication>)ViewBag.RecentPublications)
                    {
                        var sc = publication.Status switch
                        {
                            SmmGab.Domain.Enums.PublicationStatus.Published  => "status-published",
                            SmmGab.Domain.Enums.PublicationStatus.Scheduled  => "status-scheduled",
                            SmmGab.Domain.Enums.PublicationStatus.Publishing => "status-publishing",
                            SmmGab.Domain.Enums.PublicationStatus.Failed     => "status-failed",
                            _                                                 => "status-draft"
                        };
                        <div class="d-flex align-items-start gap-3 px-4 py-3" style="border-bottom:1px solid var(--glass-border);">
                            <span class="badge @sc mt-1">@publication.Status</span>
                            <div class="flex-grow-1 min-width-0">
                                <div style="font-weight:600;font-size:0.875rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    @(publication.Text.Length > 55 ? publication.Text.Substring(0, 55) + "…" : publication.Text)
                                </div>
                                <div style="font-size:0.72rem;color:var(--muted);">
                                    @publication.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")
                                    @if (publication.Targets.Any())
                                    {
                                        <span class="ms-2"><i class="bi bi-broadcast"></i> @publication.Targets.Count</span>
                                    }
                                </div>
                            </div>
                            <a asp-controller="Publications" asp-action="Details" asp-route-id="@publication.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-file-post" style="font-size:2.5rem;color:var(--muted);opacity:0.4;"></i>
                        <p class="text-muted mt-3 mb-2" style="font-size:0.875rem;">Нет публикаций</p>
                        <a asp-controller="Publications" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-success btn-sm">Создать публикацию</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
