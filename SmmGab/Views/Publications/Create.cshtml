@model SmmGab.Controllers.CreatePublicationViewModel
@{
    ViewData["Title"] = "Создать публикацию";
    ViewData["ProjectName"] = (ViewBag.Project as SmmGab.Domain.Models.Project)?.Name;
    var channels = ViewBag.Channels as List<SmmGab.Domain.Models.Channel> ?? new List<SmmGab.Domain.Models.Channel>();
}

<div class="pf-editor-wrap" style="margin:-28px;">

    <!-- ─── Left Settings Sidebar ─── -->
    <aside class="pf-editor-sidebar">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="publicationForm">
            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

            <!-- Title field -->
            <div class="pf-block">
                <div class="pf-block-title"><i class="bi bi-pencil"></i>Название</div>
                <input asp-for="Text" class="form-control" placeholder="Новая публикация" />
                <span asp-validation-for="Text" class="text-danger" style="font-size:0.72rem;"></span>
            </div>

            @if (ViewBag.Project != null)
            {
                <div class="pf-block">
                    <div class="pf-block-title"><i class="bi bi-folder2"></i>Проект</div>
                    <div style="font-size:0.875rem;color:var(--text);">@ViewBag.Project.Name</div>
                </div>
            }

            <!-- Publishing schedule -->
            <div class="pf-block">
                <div class="pf-block-title"><i class="bi bi-clock"></i>Публикация</div>
                <label class="pf-toggle-option @(Model.IsNow ? "active" : "")" id="optNow">
                    <span><i class="bi bi-lightning me-2"></i>Немедленно</span>
                    <input type="checkbox" asp-for="IsNow" />
                    <i class="bi @(Model.IsNow ? "bi-check-circle-fill" : "bi-circle") check-icon"></i>
                </label>
                <label class="pf-toggle-option @(Model.IsLater ? "active" : "")" id="optLater">
                    <span><i class="bi bi-calendar-event me-2"></i>Запланировать</span>
                    <input type="checkbox" asp-for="IsLater" />
                    <i class="bi @(Model.IsLater ? "bi-check-circle-fill" : "bi-circle") check-icon"></i>
                </label>
                <div id="scheduledDateGroup" style="display:@(Model.IsLater ? "block" : "none");margin-top:10px;">
                    <input asp-for="ScheduledAtUtc" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ScheduledAtUtc" class="text-danger" style="font-size:0.72rem;"></span>
                </div>
            </div>

            <!-- Channels -->
            <div class="pf-block">
                <div class="pf-block-title"><i class="bi bi-broadcast"></i>Каналы</div>
                @if (channels.Any())
                {
                    <div style="max-height:220px;overflow-y:auto;">
                        @foreach (var channel in channels)
                        {
                            <label class="pf-channel-item" style="cursor:pointer;margin-bottom:6px;" for="channel_@channel.Id">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @(channel.Type == SmmGab.Domain.Enums.ChannelType.Vk ? "bi-chat-dots-fill" : "bi-telegram")"
                                       style="color:@(channel.Type == SmmGab.Domain.Enums.ChannelType.Vk ? "#0077ff" : "#0088cc");"></i>
                                    <div>
                                        <div style="font-size:0.82rem;font-weight:600;">@channel.DisplayName</div>
                                        <div style="font-size:0.68rem;color:var(--muted);">@channel.Type</div>
                                    </div>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox"
                                           name="ChannelIds" value="@channel.Id"
                                           id="channel_@channel.Id" />
                                </div>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="bi bi-broadcast" style="font-size:1.8rem;color:var(--muted);opacity:0.4;"></i>
                        <p class="text-muted mt-2 mb-0" style="font-size:0.78rem;">Нет доступных каналов</p>
                    </div>
                }
            </div>

            <!-- Hidden inputs -->
            <input type="hidden" asp-for="ProjectId" />
            <input type="hidden" asp-for="IsPublish" id="isPublishInput" value="true" />
            <input type="hidden" asp-for="UploadedFileIds" id="uploadedFileIds" />
            <input type="hidden" name="Body" id="bodyHidden" />
            <input type="hidden" asp-for="ClientTimezoneMinutes" id="clientTimezoneMinutes" />
        </form>
    </aside>

    <!-- ─── Main Editor Area ─── -->
    <div class="pf-editor-main">

        <!-- Header actions bar -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-controller="Home" asp-action="Dashboard" asp-route-id="@ViewBag.Project?.Id"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Назад
            </a>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="saveAsDraft()">
                    <i class="bi bi-floppy me-1"></i>Черновик
                </button>
                <button type="submit" form="publicationForm" class="btn btn-primary btn-sm" onclick="syncBody()">
                    <i class="bi bi-send me-1"></i>Опубликовать
                </button>
            </div>
        </div>

        <!-- Quill text editor -->
        <div class="mb-3">
            <div class="pf-block-title" style="margin-bottom:10px;">
                <i class="bi bi-text-paragraph me-1"></i>Текст публикации
            </div>
            <div id="quillEditor"></div>
            <span asp-validation-for="Body" class="text-danger" style="font-size:0.78rem;"></span>
        </div>

        <!-- Media upload -->
        <div>
            <div class="pf-block-title" style="margin-bottom:10px;">
                <i class="bi bi-images me-1"></i>Медиа файлы
            </div>
            <div class="pf-media-zone" id="mediaDropZone">
                <input type="file" id="mediaFiles" name="MediaFiles"
                       multiple accept="image/*,video/*,.pdf"
                       style="display:none;" />
                <i class="bi bi-cloud-upload" style="font-size:2rem;color:var(--muted);"></i>
                <p class="text-muted mb-2 mt-2" style="font-size:0.875rem;">
                    Перетащите файлы или
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" onclick="document.getElementById('mediaFiles').click()">
                        Выбрать
                    </button>
                </p>
                <p class="text-muted mb-0" style="font-size:0.72rem;">JPG, PNG, GIF, WebP, MP4, PDF — до 2&nbsp;ГБ</p>
            </div>

            <div id="uploadProgress" class="progress mt-3" style="display:none;height:4px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width:0%"></div>
            </div>

            <div id="uploadedFilesPreview" class="row g-2 mt-2"></div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
        // ─── Quill init ───
        const quill = new Quill('#quillEditor', {
            theme: 'snow',
            placeholder: 'Введите текст публикации…',
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['blockquote', 'code-block'],
                    ['link'],
                    ['clean']
                ]
            }
        });

        // Populate from model value if present
        const existingBody = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Body ?? ""));
        if (existingBody) quill.root.innerHTML = existingBody;

        function syncBody() {
            document.getElementById('bodyHidden').value = quill.root.innerHTML;
        }

        // ─── Scheduling toggles ───
        document.getElementById('clientTimezoneMinutes').value = new Date().getTimezoneOffset();

        function setupToggle(checkboxName, optId, otherId, showGroup) {
            const opt   = document.getElementById(optId);
            const other = document.getElementById(otherId);
            const cb    = opt?.querySelector('input[type="checkbox"]');
            cb?.addEventListener('change', function () {
                if (this.checked) {
                    opt.classList.add('active');
                    opt.querySelector('.check-icon').className = 'bi bi-check-circle-fill check-icon';
                    const otherCb = other?.querySelector('input[type="checkbox"]');
                    if (otherCb) { otherCb.checked = false; other.classList.remove('active'); other.querySelector('.check-icon').className = 'bi bi-circle check-icon'; }
                } else {
                    opt.classList.remove('active');
                    opt.querySelector('.check-icon').className = 'bi bi-circle check-icon';
                }
                if (showGroup !== null) {
                    document.getElementById('scheduledDateGroup').style.display = this.checked ? 'block' : 'none';
                }
            });
        }
        setupToggle('IsNow',   'optNow',   'optLater', null);
        setupToggle('IsLater', 'optLater', 'optNow',   'scheduledDateGroup');

        // ─── Form submit ───
        document.getElementById('publicationForm')?.addEventListener('submit', syncBody);

        function saveAsDraft() {
            syncBody();
            document.getElementById('isPublishInput').value = 'false';
            document.getElementById('publicationForm')?.submit();
        }

        // ─── File upload ───
        const uploadedFileIds = [];

        document.getElementById('mediaFiles')?.addEventListener('change', async function (e) {
            await handleFiles(Array.from(e.target.files));
            e.target.value = '';
        });

        // Drag & drop
        const dropZone = document.getElementById('mediaDropZone');
        dropZone?.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--accent)'; });
        dropZone?.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; });
        dropZone?.addEventListener('drop', async e => {
            e.preventDefault(); dropZone.style.borderColor = '';
            await handleFiles(Array.from(e.dataTransfer.files));
        });

        async function handleFiles(files) {
            if (!files.length) return;
            const bar = document.getElementById('uploadProgress');
            const fill = bar?.querySelector('.progress-bar');
            if (bar) bar.style.display = 'block';

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (fill) fill.style.width = `${((i + 1) / files.length) * 100}%`;
                const fd = new FormData();
                fd.append('file', file);
                try {
                    const res = await fetch('/api/files/upload', { method: 'POST', body: fd });
                    if (!res.ok) throw new Error('Ошибка загрузки');
                    const data = await res.json();
                    uploadedFileIds.push(data.id);
                    document.getElementById('uploadedFileIds').value = uploadedFileIds.join(',');
                    addFilePreview(data, file);
                } catch (err) {
                    alert(`Ошибка загрузки ${file.name}: ${err.message}`);
                }
            }
            if (bar) bar.style.display = 'none';
        }

        function addFilePreview(fileData, originalFile) {
            const container = document.getElementById('uploadedFilesPreview');
            if (!container) return;
            const col = document.createElement('div');
            col.className = 'col-md-3 col-sm-4 col-6';
            const isImg = fileData.type === 'Image';
            const isVid = fileData.type === 'Video';
            col.innerHTML = `
                <div class="pf-file-preview position-relative" style="overflow:hidden;border-radius:10px;">
                    ${isImg
                        ? `<img src="/api/files/${fileData.id}/download" style="width:100%;height:90px;object-fit:cover;" alt="${originalFile.name}">`
                        : `<div style="height:90px;background:var(--bg2);display:flex;align-items:center;justify-content:center;">
                               <i class="bi ${isVid ? "bi-play-circle" : "bi-file-earmark"}" style="font-size:1.8rem;color:var(--muted);"></i>
                           </div>`}
                    <div style="padding:6px 8px;font-size:0.68rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${originalFile.name}">${originalFile.name}</div>
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-1 remove-file-btn"
                            data-file-id="${fileData.id}" style="padding:2px 6px;font-size:0.7rem;line-height:1.4;">
                        <i class="bi bi-x"></i>
                    </button>
                </div>`;
            container.appendChild(col);
            col.querySelector('.remove-file-btn')?.addEventListener('click', function () {
                const id = this.getAttribute('data-file-id');
                const idx = uploadedFileIds.indexOf(id);
                if (idx > -1) { uploadedFileIds.splice(idx, 1); document.getElementById('uploadedFileIds').value = uploadedFileIds.join(','); }
                col.remove();
            });
        }
    </script>
}
