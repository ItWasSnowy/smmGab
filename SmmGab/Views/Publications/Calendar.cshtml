@model IEnumerable<SmmGab.Domain.Models.Publication>
@{
    ViewData["Title"] = "Календарь публикаций";
    var year = ViewBag.Year as int? ?? DateTime.UtcNow.Year;
    var month = ViewBag.Month as int? ?? DateTime.UtcNow.Month;
    var startDate = ViewBag.StartDate as DateTime? ?? new DateTime(year, month, 1);
    var daysInMonth = DateTime.DaysInMonth(year, month);
    var firstDayOfWeek = (int)startDate.DayOfWeek;
    if (firstDayOfWeek == 0) firstDayOfWeek = 7; // Понедельник = 1
    firstDayOfWeek--; // Для отображения понедельника как первого дня
}

<div class="pf-page-header pf-animate">
    <div>
        <h1 class="pf-page-title">Календарь</h1>
        <p class="pf-page-subtitle">
            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month) @year
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Publications" asp-action="Calendar"
           asp-route-year="@(month == 1 ? year - 1 : year)"
           asp-route-month="@(month == 1 ? 12 : month - 1)"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-chevron-left"></i> Предыдущий
        </a>
        <a asp-controller="Publications" asp-action="Calendar"
           asp-route-year="@(month == 12 ? year + 1 : year)"
           asp-route-month="@(month == 12 ? 1 : month + 1)"
           class="btn btn-outline-secondary btn-sm">
            Следующий <i class="bi bi-chevron-right"></i>
        </a>
    </div>
</div>

<div class="card pf-animate pf-animate-delay-1" style="overflow:hidden;">
    <table class="pf-cal-table table table-bordered mb-0">
        <thead>
            <tr>
                <th>Пн</th><th>Вт</th><th>Ср</th><th>Чт</th><th>Пт</th><th>Сб</th><th>Вс</th>
            </tr>
        </thead>
        <tbody>
            @{
                var day = 1;
                var publicationsByDay = Model.GroupBy(p => p.ScheduledAtUtc?.Day ?? 0).ToDictionary(g => g.Key, g => g.ToList());
                var today = DateTime.UtcNow;
                var isCurrentMonth = today.Year == year && today.Month == month;
            }
            @for (int week = 0; week < 6; week++)
            {
                <tr>
                    @for (int dayOfWeek = 0; dayOfWeek < 7; dayOfWeek++)
                    {
                        var isToday = isCurrentMonth && day == today.Day;
                        <td class="@(isToday ? "cal-today" : "")">
                            @if (week == 0 && dayOfWeek < firstDayOfWeek)
                            {
                                <span></span>
                            }
                            else if (day <= daysInMonth)
                            {
                                <span class="pf-day-num @(isToday ? "today-circle" : "")">@day</span>
                                @if (publicationsByDay.ContainsKey(day))
                                {
                                    <div style="max-height:70px;overflow-y:auto;margin-top:4px;">
                                        @foreach (var pub in publicationsByDay[day])
                                        {
                                            var sc = pub.Status switch
                                            {
                                                SmmGab.Domain.Enums.PublicationStatus.Published  => "status-published",
                                                SmmGab.Domain.Enums.PublicationStatus.Failed     => "status-failed",
                                                SmmGab.Domain.Enums.PublicationStatus.Publishing => "status-publishing",
                                                SmmGab.Domain.Enums.PublicationStatus.Scheduled  => "status-scheduled",
                                                _                                                => "status-draft"
                                            };
                                            <a asp-controller="Publications" asp-action="Details" asp-route-id="@pub.Id"
                                               class="badge @sc d-block mb-1 text-decoration-none text-start"
                                               style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
                                               title="@pub.Text">
                                                @(pub.Text.Length > 20 ? pub.Text.Substring(0, 20) + "…" : pub.Text)
                                            </a>
                                        }
                                    </div>
                                }
                                day++;
                            }
                        </td>
                    }
                </tr>
                @if (day > daysInMonth) break;
            }
        </tbody>
    </table>
</div>
