@model IEnumerable<SmmGab.Domain.Models.Publication>
@{
    ViewData["Title"] = "Публикации";
}

<div class="pf-page-header pf-animate">
    <div>
        <h1 class="pf-page-title">Публикации</h1>
    </div>
    <a asp-controller="Publications" asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus me-1"></i>Создать публикацию
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-3 pf-animate pf-animate-delay-1">
        @foreach (var publication in Model)
        {
            var sc = publication.Status switch
            {
                SmmGab.Domain.Enums.PublicationStatus.Published  => "status-published",
                SmmGab.Domain.Enums.PublicationStatus.Failed     => "status-failed",
                SmmGab.Domain.Enums.PublicationStatus.Publishing => "status-publishing",
                SmmGab.Domain.Enums.PublicationStatus.Scheduled  => "status-scheduled",
                _                                                => "status-draft"
            };
            <div class="col-md-6 col-lg-4">
                <div class="pf-item-card d-flex flex-column gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="pf-icon-badge" style="background:rgba(39,201,63,0.14);color:#27C93F;">
                            <i class="bi bi-file-post"></i>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div style="font-weight:700;font-size:0.875rem;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(publication.Text.Length > 55 ? publication.Text.Substring(0, 55) + "…" : publication.Text)
                            </div>
                            <span class="badge @sc">@publication.Status</span>
                        </div>
                    </div>
                    <div style="border-top:1px solid var(--glass-border);padding-top:12px;font-size:0.78rem;color:var(--muted);">
                        <div class="mb-1"><i class="bi bi-folder me-1"></i>@publication.Project.Name</div>
                        @if (publication.ScheduledAtUtc.HasValue)
                        {
                            <div><i class="bi bi-calendar3 me-1"></i>@publication.ScheduledAtUtc.Value.ToString("dd.MM.yyyy HH:mm")</div>
                        }
                        else
                        {
                            <div><i class="bi bi-clock me-1"></i>Не запланировано</div>
                        }
                    </div>
                    <a asp-controller="Publications" asp-action="Details" asp-route-id="@publication.Id"
                       class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-eye me-1"></i>Подробнее
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card pf-animate">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-post" style="font-size:3rem;color:var(--muted);opacity:0.35;"></i>
            <p class="text-muted mt-3 mb-3" style="font-size:0.875rem;">У вас пока нет публикаций</p>
            <a asp-controller="Publications" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus me-1"></i>Создайте первую публикацию
            </a>
        </div>
    </div>
}
