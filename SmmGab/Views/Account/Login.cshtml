@model SmmGab.Models.LoginViewModel
@{
    ViewData["Title"] = "Вход";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <a asp-controller="Home" asp-action="Index" class="auth-logo">Plani<span>fy</span></a>
        <div class="text-center mb-4">
            <h2 class="auth-title">Добро пожаловать</h2>
            <p class="auth-sub text-muted mb-0">Войдите в свой аккаунт</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-1"></i>Email</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"><i class="bi bi-lock me-1"></i>Пароль</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">@Html.DisplayNameFor(m => m.RememberMe)</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-3" style="padding:12px;">
                <i class="bi bi-box-arrow-in-right me-2"></i>Войти
            </button>
            <p class="text-center mb-0" style="font-size:0.875rem;color:var(--muted);">
                Нет аккаунта?
                <a asp-controller="Account" asp-action="Register" style="color:var(--accent);font-weight:600;text-decoration:none;">Зарегистрироваться</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
