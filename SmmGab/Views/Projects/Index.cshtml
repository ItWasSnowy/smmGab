@model IEnumerable<SmmGab.Domain.Models.Project>
@{
    ViewData["Title"] = "Проекты";
}

<div class="pf-page-header pf-animate">
    <div>
        <h1 class="pf-page-title">Проекты</h1>
    </div>
    <a asp-controller="Projects" asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus me-1"></i>Создать проект
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-3 pf-animate pf-animate-delay-1">
        @foreach (var project in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="pf-item-card d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="pf-icon-badge" style="background:rgba(255,77,109,0.14);color:var(--accent);">
                            <i class="bi bi-folder2"></i>
                        </div>
                        <div>
                            <div style="font-weight:700;font-size:0.9rem;">@project.Name</div>
                            <div style="font-size:0.72rem;color:var(--muted);">
                                <i class="bi bi-calendar3 me-1"></i>@project.CreatedAtUtc.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    </div>
                    <div style="border-top:1px solid var(--glass-border);padding-top:10px;display:flex;justify-content:space-between;font-size:0.78rem;color:var(--muted);">
                        <span><i class="bi bi-broadcast me-1"></i>@project.Channels.Count каналов</span>
                        <span><i class="bi bi-file-post me-1"></i>@project.Publications.Count публикаций</span>
                    </div>
                    <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id"
                       class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-eye me-1"></i>Подробнее
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card pf-animate">
        <div class="card-body text-center py-5">
            <i class="bi bi-folder-x" style="font-size:3rem;color:var(--muted);opacity:0.35;"></i>
            <p class="text-muted mt-3 mb-3" style="font-size:0.875rem;">У вас пока нет проектов</p>
            <a asp-controller="Projects" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus me-1"></i>Создайте первый проект
            </a>
        </div>
    </div>
}

